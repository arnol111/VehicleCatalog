<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:VehicleCatalog.Maui.Models"
             x:Class="VehicleCatalog.Maui.MarcasPage"
             Title="Marcas">

    <CollectionView ItemsSource="{Binding Brands}"
                    x:Name="brandsCollection">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:CarBrand">
                <Border Style="{StaticResource CollectionItemSeparator}">
                    <Label Text="{Binding Name}"
                           Padding="16,12"
                           Style="{StaticResource LabelTitle}" />
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
